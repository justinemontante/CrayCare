// CrayCare — Normalized Relational Schema (3NF logical model)
// Field names mirror the Firestore runtime field names used by the Flutter
// app, Cloud Functions, and ESP32 firmware (documented in the Data
// Dictionary deliverable). Import in dbdiagram.io as DBML.

Project CrayCare {
  database_type: 'PostgreSQL'
  Note: 'Normalized SQL logical model. Source facts are stored once; calculated values are produced by queries or views. Operational read/staging models are identified explicitly. Firestore persistence notes are attached per table. Logical keys representing Firestore document IDs are path identifiers and may not be stored fields.'
}

Table users {
  uid varchar [pk, note: 'Firebase Authentication UID and users/{uid} document ID; not duplicated as a stored uid field']
  full_name varchar [not null]
  email varchar [not null, unique]
  role varchar [not null, note: 'owner | admin']
  status varchar [not null, note: 'active | disabled']
  photo_url text
  fcmTokens text [note: 'Firestore array<string>: one FCM registration token per logged-in device']
  created_at timestamp [not null]
}

Table notification_settings [note: 'Persisted at users/{uid}/notification_settings/preferences; uid is the parent document ID, not a stored child field'] {
  uid varchar [pk, ref: - users.uid, note: 'Parent Firebase Authentication UID']
  sound boolean [not null, default: true]
  vibration boolean [not null, default: true]
  critical boolean [not null, default: true]
  warning boolean [not null, default: true]
  feeding boolean [not null, default: true]
  sampling boolean [not null, default: true]
  operational boolean [not null, default: true]
  updated_at timestamp
}

Table tanks [note: 'Persisted at tanks/{tankId}; tankId is the owner Firebase Authentication UID. Stores tank ownership, setup state, and the active-batch pointer only'] {
  tank_id varchar [pk, note: 'Firestore document ID: owner Firebase Authentication UID; not a stored field']
  owner_uid varchar [not null, unique, ref: - users.uid]
  current_batch_id varchar [note: 'Active batch document ID, format CR-YYYYMMDD-###']
  is_initialized boolean [not null, default: false]
  created_at timestamp [not null]
}

Table hardware_assignments [note: 'Firestore keeps a singleton hardware_system/currentOwner document (fields: uid, tank_id, assigned_by, assigned_at); uid and tank_id are null when unassigned'] {
  assignment_id varchar [pk, note: 'Conceptual key only; actual fixed Firestore document ID is hardware_system/currentOwner']
  uid varchar [note: 'Stored on hardware_system/currentOwner; null when unassigned']
  tank_id varchar [unique, ref: - tanks.tank_id, note: 'Stored on hardware_system/currentOwner; null when unassigned']
  assigned_by varchar [not null, ref: > users.uid]
  assigned_at timestamp [not null]
}

Table notifications [note: 'Persisted at notifications/{notificationId}'] {
  notification_id varchar [pk, note: 'Firestore document ID; auto-ID by default or deterministic SHA-256 event ID for idempotent server notifications; not a stored field']
  uid varchar [not null, ref: > users.uid]
  notif_type varchar [not null, note: 'critical | warning | operational | reminder | feeding | general']
  title varchar [not null]
  body text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null]
  Indexes {
    (uid, created_at)
  }
}

Table sensor_thresholds [note: 'Persisted at tanks/{tankId}/sensors/{sensorName}; sensor_name is the fixed document ID'] {
  tank_id varchar [not null, ref: > tanks.tank_id, note: 'Parent tank document ID; not stored on child document']
  sensor_name varchar [not null, note: 'Fixed document ID: temperature | ph_level | dissolved_oxygen | turbidity | water_level | feed_level']
  min_value decimal(10,2) [note: 'Water-quality sensors only; not used for water_level or feed_level']
  max_value decimal(10,2) [note: 'Water-quality sensors only; not used for water_level or feed_level']
  low_value decimal(10,2) [note: 'Low threshold for water_level (cm) or feed_level (percent)']
  critical_value decimal(10,2) [note: 'Feed-level or water-level critical threshold']
  updated_at timestamp
  Indexes {
    (tank_id, sensor_name) [pk]
  }
}

Table sensor_readings_history [note: '10-minute sensor-history records. The parent daily record is used internally to summarize the same history for long-range analytics; it is not shown as a separate ERD table.'] {
  tank_id varchar [not null, ref: > tanks.tank_id, note: 'Parent tank document ID; not stored on entry']
  reading_id varchar [not null, note: 'Firestore Auto-ID inherited from sensorIngestion history; not a stored field']
  temp_min decimal(6,2)
  temp_max decimal(6,2)
  temp_avg decimal(6,2)
  pH_min decimal(5,2)
  pH_max decimal(5,2)
  pH_avg decimal(5,2)
  DO_min decimal(5,2)
  DO_max decimal(5,2)
  DO_avg decimal(5,2)
  turbidity_min decimal(8,2)
  turbidity_max decimal(8,2)
  turbidity_avg decimal(8,2)
  water_level decimal(6,2) [note: 'Single water-level reading in centimeters; no min/max aggregate']
  feed_level decimal(6,2)
  recorded_at timestamp [not null]
  Indexes {
    (tank_id, reading_id) [pk]
    (tank_id, recorded_at)
  }
}

Table sensor_readings [note: 'Operational latest-reading projection; outside the strict transactional 3NF core. Persisted at tanks/{tankId}/sensor_readings/latest'] {
  tank_id varchar [pk, ref: - tanks.tank_id]
  temperature decimal(6,2)
  ph_level decimal(5,2)
  dissolved_oxygen decimal(5,2)
  turbidity decimal(8,2)
  turbidity_air boolean
  water_level decimal(6,2)
  feed_level decimal(6,2)
  buffered_entries int
  recorded_at timestamp [not null]
}

Table actuators [note: 'Persisted at tanks/{tankId}/actuators/{deviceId}; device_id is the doc ID'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  device_id varchar [not null, note: 'pump | aerator1 | aerator2']
  control_mode varchar [not null, note: 'on | off | auto']
  current_state varchar [not null, note: 'on | off']
  last_changed timestamp [note: 'Firestore Timestamp; null before the first device-reported change; legacy epoch-ms may exist']
  Indexes {
    (tank_id, device_id) [pk]
  }
}

Table actuator_logs [note: 'Persisted at tanks/{tankId}/actuator_logs/{logId}; logged_at is a Firestore Timestamp'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  log_id varchar [not null, note: 'Document ID; not a stored field']
  actuator_type varchar [not null]
  action varchar [not null]
  type varchar [not null, note: 'on | off | auto (resulting relay state or source label)']
  logged_at timestamp [not null]
  Indexes {
    (tank_id, log_id) [pk]
    (tank_id, logged_at)
  }
}

Table feeder_status [note: 'Operational current-state projection; one row per tank. Persisted at tanks/{tankId}/feeder/status with camelCase fields dispenseCount and lastSeen'] {
  tank_id varchar [pk, ref: - tanks.tank_id]
  command_id varchar
  status varchar [not null, note: 'idle | checking_feed_level | dispensing | completed | blocked | skipped_insufficient | failed']
  status_reason varchar
  dispenseCount int [not null, default: 0, note: 'Persisted in ESP32 NVS across reboots']
  lastSeen timestamp [note: 'Firestore Timestamp; legacy integer epoch-ms may exist']
  last_dispensed_at timestamp [note: 'Firestore Timestamp; null until first dispense']
  feed_level decimal(6,2)
}

Table feeder_policy [note: 'Shared schedule policy persisted at tanks/{tankId}/feeder/schedule_policy; one owner-level setting applies to all schedules, not per schedule'] {
  tank_id varchar [pk, ref: - tanks.tank_id]
  allow_water_quality_override boolean [not null, default: false, note: 'Allows scheduled feeding despite out-of-range temperature, pH, dissolved oxygen, or turbidity only; sensor faults, stale readings, turbidity-in-air, and critical feed level still block']
  updated_at timestamp
}

Table feeder_schedules [note: 'Persisted at tanks/{tankId}/feeder_schedules/{scheduleId}; the weekly day mask is stored as one days string on this document (logical model also normalizes it below)'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  schedule_id varchar [not null, note: 'Document ID; not a stored field']
  time varchar [not null, note: 'HH:MM 12-hour; paired with ampm']
  ampm varchar [not null, note: 'AM | PM']
  timeValue int [not null, note: 'Minutes since midnight; used for sorting']
  grams decimal(8,2) [not null, default: 20]
  enabled boolean [not null, default: true]
  days varchar [not null, note: '7-character Sunday-first mask (e.g. 0111110)']
  isDone boolean [not null, default: false, note: 'Legacy compatibility; true only for the completed current occurrence']
  effective_at_ms int [not null, note: 'Integer epoch-ms; prevents new/edited schedules from being treated as retroactively due']
  last_outcome varchar [note: 'completed | blocked | skipped_insufficient | failed']
  last_occurrence_at timestamp [note: 'Firestore Timestamp; legacy integer epoch-ms may exist']
  created_at timestamp [not null]
  Indexes {
    (tank_id, schedule_id) [pk]
    (tank_id, timeValue)
  }
}

Table feeder_schedule_days [note: 'Logical normalization of the days mask only; Firestore stores days once on the schedule document (no separate collection)'] {
  tank_id varchar [not null]
  schedule_id varchar [not null]
  day_of_week smallint [not null, note: '0=Sunday through 6=Saturday']
  Indexes {
    (tank_id, schedule_id, day_of_week) [pk]
  }
}

Table feeder_commands [note: 'Manual Feed Now commands persisted at tanks/{tankId}/feeder_commands/{commandId}; ESP32 reads and deletes processed commands'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  command_id varchar [not null, note: 'Document ID; not a stored field']
  command_type varchar [not null, note: 'feed_now']
  grams decimal(8,2) [not null, default: 20]
  issued_by varchar [not null, ref: > users.uid]
  issued_at timestamp [not null]
  expires_at timestamp [not null]
  near_schedule_confirmed boolean [not null, default: false, note: 'Owner acknowledged warning-window proximity; never bypasses device collision block']
  allow_water_quality_override boolean [note: 'Optional one-time Feed Now override for water-quality ranges only; does not bypass sensor faults, stale readings, or critical feed level']
  Indexes {
    (tank_id, command_id) [pk]
  }
}

Table feeder_logs [note: 'Feeding lifecycle/audit logs at tanks/{tankId}/feeder_logs/{logId}; event times are Firestore Timestamps'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  log_id varchar [not null, note: 'Document ID; not a stored field']
  command_id varchar
  schedule_key varchar [note: 'Originating schedule document ID (runtime field name: schedule_key)']
  schedule_time varchar [note: 'Expected schedule time, human-readable']
  action varchar [not null]
  type varchar [not null, note: 'auto | manual | missed | error | pending_confirmation']
  status varchar [note: 'completed | forced | blocked | skipped_insufficient | failed; null for non-terminal audit entries such as pending_confirmation']
  occurrence_at timestamp [note: 'Firestore Timestamp']
  trigger_source varchar [note: 'physical_button | schedule | manual_request']
  requested_grams decimal(8,2)
  estimated_dispensed_grams decimal(8,2) [note: 'Servo-cycle estimate recorded for completed or forced feeding; not a measured hopper remainder']
  amount_basis varchar [note: 'Basis for estimated_dispensed_grams; currently servo_cycle_estimate']
  feed_level_before decimal(6,2)
  feed_level_after decimal(6,2)
  level_change_detected boolean
  verification_note text [note: 'Optional warning when a completed cycle has no detectable feed-level decrease']
  logged_at timestamp [not null]
  Indexes {
    (tank_id, log_id) [pk]
    (tank_id, logged_at)
  }
}

TableGroup "Feeding Control" {
  feeder_status
  feeder_policy
  feeder_schedules
  feeder_schedule_days
  feeder_commands
  feeder_logs
}

Ref: feeder_schedule_days.(tank_id, schedule_id) > feeder_schedules.(tank_id, schedule_id)

Table water_quality_anomaly_detections [note: 'Logical anomaly-detection record model. The current result and hourly history use the same fields in separate Firestore locations for fast dashboard access and historical retrieval.'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  uid varchar [note: 'Owner UID attached by the Cloud Function']
  detection_id varchar [not null, note: 'Logical child-record identifier; maps to the Firestore document ID: current for latest or YYYYMMDDTHHMMSS for history']
  status varchar [not null, note: 'Normal | Unusual | Insufficient']
  is_anomaly boolean [not null]
  anomaly_score decimal(5,2) [not null, note: '0–100 percentile relative to reference patterns; not a safety score']
  source varchar [not null, note: 'WQAD model | Model unavailable | Insufficient data | Stale sensor history']
  data_status varchar [not null, note: 'ready | insufficient | stale']
  source_recorded_at timestamp [note: 'Firestore Timestamp; null when no source reading exists']
  insight text [not null]
  recommendation text [not null]
  processed_at timestamp [not null, note: 'Firestore Timestamp; app orders history by it']
  contributors json [not null, note: 'Firestore array of {sensor, value, direction, contribution_score}; labels and units are mapped in the app; empty array when none']
  Indexes {
    (tank_id, detection_id) [pk]
    (tank_id, processed_at)
  }
  Note: 'Unsupervised Isolation Forest output; safety thresholds remain separate and are not training labels.'
}

Table batches [note: 'Persisted at tanks/{tankId}/batches/{batchId}; growth averages are derived by the app from the baseline sampling record measurements, not stored on the batch document'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  batch_id varchar [not null, note: 'Document ID; not a stored field']
  batch_status varchar [not null, note: 'active | harvested | superseded']
  stocking_date timestamp [not null, note: 'Firestore Timestamp; calendar day of stocking']
  harvest_date timestamp [note: 'Firestore Timestamp; null until harvested']
  ended_at timestamp [note: 'Firestore Timestamp; set when a batch is superseded without harvest']
  initial_count int [not null]
  current_count int [not null, note: 'Live population currently tracked']
  harvest_count int [not null, default: 0]
  total_mortality int [not null, default: 0]
  harvest_weight_grams decimal(12,2)
  sample_count int [note: 'Number of individual measurements in the baseline sampling record']
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id) [pk]
    (tank_id, batch_status)
  }
}

Table sampling_records [note: 'Persisted at tanks/{tankId}/batches/{batchId}/sampling_records/{recordId}; baseline document ID is fixed as baseline'] {
  tank_id varchar [not null]
  batch_id varchar [not null]
  sampling_id varchar [not null, note: 'Document ID; not a stored field']
  sampling_date timestamp [not null, note: 'Firestore Timestamp; calendar day of sampling']
  live_count int [not null]
  is_baseline boolean [not null, default: false, note: 'True for the Day 0 baseline; false for weekly samples']
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id, sampling_id) [pk]
    (tank_id, batch_id, sampling_date)
  }
  Note: 'Sample size, total weight and length, ABW, ABL, and biomass are derived from the associated individual measurement rows. Historical records may still contain legacy aggregate fields and remain readable.'
}

Table sampling_measurements [note: 'One row for each crayfish measured in a sampling session'] {
  tank_id varchar [not null]
  batch_id varchar [not null]
  sampling_id varchar [not null]
  sample_number int [not null, note: 'Sequential within one sampling session, starting at 1']
  label varchar [not null, note: 'Human-readable label, such as Crayfish 1']
  weight_g decimal(10,2) [not null, note: 'Individual crayfish weight in grams; must be greater than zero']
  length_cm decimal(10,2) [not null, note: 'Individual crayfish length in centimeters; must be greater than zero']
  Indexes {
    (tank_id, batch_id, sampling_id, sample_number) [pk]
  }
}

Table mortality_records [note: 'Persisted at tanks/{tankId}/batches/{batchId}/mortality_records/{recordId}'] {
  tank_id varchar [not null]
  batch_id varchar [not null]
  mortality_id varchar [not null, note: 'Document ID; not a stored field']
  mortality_date timestamp [not null, note: 'Firestore Timestamp; date mortality was recorded']
  mortality_count int [not null]
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id, mortality_id) [pk]
  }
}

Table harvest_records [note: 'Persisted at tanks/{tankId}/batches/{batchId}/harvest_records/{recordId}; harvest ABW is app-derived from total_weight_kg and harvest_count, not stored'] {
  tank_id varchar [not null]
  batch_id varchar [not null]
  harvest_id varchar [not null, note: 'Document ID; not a stored field']
  harvest_date timestamp [not null, note: 'Firestore Timestamp; date of harvest']
  harvest_count int [not null]
  total_weight_kg decimal(10,3) [not null]
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id, harvest_id) [pk]
  }
}

Ref: sampling_records.(tank_id, batch_id) > batches.(tank_id, batch_id)
Ref: sampling_measurements.(tank_id, batch_id, sampling_id) > sampling_records.(tank_id, batch_id, sampling_id)
Ref: mortality_records.(tank_id, batch_id) > batches.(tank_id, batch_id)
Ref: harvest_records.(tank_id, batch_id) > batches.(tank_id, batch_id)

// ABW/ABL, sampling biomass, and days-in-culture are app-derived and not persisted.
// Days-in-culture is recalculated from stocking_date to today (active) or harvest_date (completed).
