// CrayCare — Normalized Relational Schema (3NF logical model)
// Import in dbdiagram.io as DBML. The deployed Firestore structure is
// documented separately in FIRESTORE_STRUCTURE_ACTUAL.md.

Project CrayCare {
  database_type: 'PostgreSQL'
  Note: 'Normalized SQL logical model. Source facts are stored once; calculated values are produced by queries or views. Operational read/staging models are identified explicitly.'
}

Table users {
  uid varchar [pk, note: 'Firebase Authentication UID']
  full_name varchar [not null]
  email varchar [not null, unique]
  role varchar [not null, note: 'owner | admin']
  status varchar [not null, note: 'active | disabled']
  photo_url text
  created_at timestamp [not null]
}

Table user_device_tokens {
  uid varchar [not null, ref: > users.uid]
  token varchar [not null]
  registered_at timestamp
  Indexes { (uid, token) [pk] }
}

Table notification_settings {
  uid varchar [pk, ref: - users.uid]
  sound boolean [not null, default: true]
  vibration boolean [not null, default: true]
  critical boolean [not null, default: true]
  warning boolean [not null, default: true]
  feeding boolean [not null, default: true]
  sampling boolean [not null, default: true]
  operational boolean [not null, default: true]
  updated_at timestamp
}

Table notification_markers {
  uid varchar [not null, ref: > users.uid]
  marker_key varchar [not null]
  marker_value text
  updated_at timestamp
  Indexes { (uid, marker_key) [pk] }
}

Table tanks {
  tank_id varchar [pk]
  owner_uid varchar [not null, unique, ref: - users.uid]
  created_at timestamp [not null]
}

Table hardware_assignments {
  assignment_id varchar [pk]
  tank_id varchar [not null, unique, ref: - tanks.tank_id]
  assigned_by varchar [not null, ref: > users.uid]
  assigned_at timestamp [not null]
  Note: 'Firestore uses singleton hardware_system/currentOwner and also stores uid for authorization.'
}

Table notifications {
  notification_id varchar [pk]
  uid varchar [not null, ref: > users.uid]
  notification_type varchar [not null, note: 'critical | warning | reminder | device_auto | general']
  title varchar [not null]
  body text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null]
  Indexes { (uid, created_at) }
}

Table sensor_thresholds {
  tank_id varchar [not null, ref: > tanks.tank_id]
  sensor_name varchar [not null, note: 'temperature | ph_level | dissolved_oxygen | turbidity | water_level | feed_level']
  min_value decimal(10,2) [not null]
  max_value decimal(10,2) [not null]
  critical_value decimal(10,2) [note: 'Feed-level critical-low percentage only']
  hopper_capacity_grams decimal(10,2) [note: 'Feed-level full-capacity calibration only']
  updated_at timestamp
  Indexes { (tank_id, sensor_name) [pk] }
}

Table sensor_readings_history {
  tank_id varchar [not null, ref: > tanks.tank_id]
  reading_id varchar [not null]
  date_key varchar [not null, note: 'YYYY-MM-DD in Asia/Manila']
  temp_min decimal(6,2)
  temp_max decimal(6,2)
  temp_avg decimal(6,2)
  ph_min decimal(5,2)
  ph_max decimal(5,2)
  ph_avg decimal(5,2)
  do_min decimal(5,2)
  do_max decimal(5,2)
  do_avg decimal(5,2)
  turbidity_min decimal(8,2)
  turbidity_max decimal(8,2)
  turbidity_avg decimal(8,2)
  water_level_min decimal(6,2)
  water_level_max decimal(6,2)
  water_level_avg decimal(6,2)
  feed_level decimal(5,2)
  estimated_feed_grams decimal(10,2)
  recorded_at timestamp [not null]
  Indexes {
    (tank_id, reading_id) [pk]
    (tank_id, recorded_at)
  }
}

Table sensor_readings [note: 'Operational latest-reading projection; outside the strict transactional 3NF core'] {
  tank_id varchar [pk, ref: - tanks.tank_id]
  temperature decimal(6,2)
  ph_level decimal(5,2)
  dissolved_oxygen decimal(5,2)
  turbidity decimal(8,2)
  turbidity_air boolean
  water_level decimal(6,2)
  feed_level decimal(5,2)
  estimated_feed_grams decimal(10,2)
  buffered_entries int
  recorded_at timestamp [not null]
}

Table sensor_daily_summaries [note: 'Materialized analytics read model generated from history for fast long-range charts'] {
  tank_id varchar [not null, ref: > tanks.tank_id]
  date_key varchar [not null]
  sample_count int [not null]
  temp_min decimal(6,2)
  temp_max decimal(6,2)
  temp_avg decimal(6,2)
  ph_min decimal(5,2)
  ph_max decimal(5,2)
  ph_avg decimal(5,2)
  do_min decimal(5,2)
  do_max decimal(5,2)
  do_avg decimal(5,2)
  turbidity_min decimal(8,2)
  turbidity_max decimal(8,2)
  turbidity_avg decimal(8,2)
  water_level_min decimal(6,2)
  water_level_max decimal(6,2)
  water_level_avg decimal(6,2)
  updated_at timestamp
  Indexes { (tank_id, date_key) [pk] }
}

Table sensor_ingestion [note: 'Operational ESP32 staging/quarantine data; outside the strict transactional 3NF core'] {
  ingestion_id varchar [pk]
  hardware_id varchar [not null]
  source_tank_id varchar
  source_owner_uid varchar
  source_assignment_at_ms bigint
  captured_at_ms bigint [not null]
  routing_status varchar
  routing_reason varchar
  payload json [not null]
}

Table actuators {
  tank_id varchar [not null, ref: > tanks.tank_id]
  device_id varchar [not null, note: 'pump | aerator1 | aerator2']
  control_mode varchar [not null, note: 'on | off | auto']
  current_state varchar [not null, note: 'on | off']
  last_changed timestamp
  Indexes { (tank_id, device_id) [pk] }
}

Table actuator_logs {
  tank_id varchar [not null, ref: > tanks.tank_id]
  log_id varchar [not null]
  actuator_type varchar [not null]
  action varchar [not null]
  action_type varchar [not null]
  logged_at timestamp [not null]
  Indexes {
    (tank_id, log_id) [pk]
    (tank_id, logged_at)
  }
}

Table feeder_status [note: 'Operational current-state projection; one row per tank'] {
  tank_id varchar [pk, ref: - tanks.tank_id]
  command_id varchar
  status varchar [not null, note: 'idle | checking_feed_level | dispensing | completed | skipped_insufficient | blocked']
  status_reason varchar
  dispense_count int [not null, default: 0]
  last_seen timestamp
  last_dispensed_at timestamp
  last_dispensed_grams decimal(8,2)
  feed_level decimal(5,2)
  estimated_feed_grams decimal(10,2)
}

Table feeder_schedules {
  tank_id varchar [not null, ref: > tanks.tank_id]
  schedule_id varchar [not null]
  feed_time time [not null]
  grams decimal(8,2) [not null, default: 20]
  enabled boolean [not null, default: true]
  effective_at timestamp [not null]
  created_at timestamp [not null]
  Indexes {
    (tank_id, schedule_id) [pk]
    (tank_id, feed_time)
  }
}

Table feeder_schedule_days {
  tank_id varchar [not null]
  schedule_id varchar [not null]
  day_of_week smallint [not null, note: '0=Sunday through 6=Saturday']
  Indexes { (tank_id, schedule_id, day_of_week) [pk] }
}

Table feeder_commands {
  tank_id varchar [not null, ref: > tanks.tank_id]
  command_id varchar [not null]
  command_type varchar [not null, note: 'feed_now']
  grams decimal(8,2) [not null, default: 20]
  issued_by varchar [not null, ref: > users.uid]
  issued_at timestamp [not null]
  expires_at timestamp [not null]
  Indexes { (tank_id, command_id) [pk] }
}

Table feeder_logs {
  tank_id varchar [not null, ref: > tanks.tank_id]
  log_id varchar [not null]
  command_id varchar
  schedule_id varchar
  action varchar [not null]
  feeding_type varchar [not null, note: 'auto | manual | missed | error']
  status varchar [not null, note: 'completed | skipped_insufficient | blocked | failed']
  occurrence_at timestamp
  requested_grams decimal(8,2)
  estimated_dispensed_grams decimal(8,2)
  amount_basis varchar [note: 'servo_cycle_estimate']
  estimated_available_grams decimal(10,2)
  feed_level_before decimal(5,2)
  feed_level_after decimal(5,2)
  level_change_detected boolean
  verification_note varchar
  logged_at timestamp [not null]
  Indexes {
    (tank_id, log_id) [pk]
    (tank_id, logged_at)
  }
}

Table feeder_notification_receipts {
  tank_id varchar [not null]
  log_id varchar [not null]
  push_attempt_claimed_at timestamp [not null]
  Indexes { (tank_id, log_id) [pk] }
}

Ref: feeder_schedule_days.(tank_id, schedule_id) > feeder_schedules.(tank_id, schedule_id)
Ref: feeder_notification_receipts.(tank_id, log_id) - feeder_logs.(tank_id, log_id)

Table water_quality_anomaly_detections {
  tank_id varchar [not null, ref: > tanks.tank_id]
  detection_id varchar [not null]
  status varchar [not null, note: 'Normal | Unusual | Insufficient']
  is_anomaly boolean [not null, default: false]
  anomaly_score decimal(5,2)
  source varchar [not null]
  model_algorithm varchar [not null, note: 'IsolationForest | Not applied']
  model_version varchar
  training_data_origin varchar
  training_label_origin varchar [note: 'none_unsupervised']
  model_feature_count int
  analysis_window_minutes int
  data_status varchar [not null, note: 'ready | insufficient | stale']
  source_recorded_at timestamp
  source_age_seconds int
  driver varchar
  driver_label varchar
  driver_value decimal(10,2)
  driver_unit varchar
  insight text [not null]
  recommendation text [not null]
  detected_at timestamp [not null]
  Indexes {
    (tank_id, detection_id) [pk]
    (tank_id, detected_at)
  }
  Note: 'Unsupervised model; safety thresholds remain separate and are not training labels.'
}

Table water_quality_anomaly_contributors {
  tank_id varchar [not null]
  detection_id varchar [not null]
  rank_no smallint [not null]
  sensor_name varchar [not null]
  sensor_label varchar [not null]
  sensor_value decimal(10,2)
  unit varchar
  direction varchar
  contribution_score decimal(10,4)
  Indexes { (tank_id, detection_id, rank_no) [pk] }
}

Ref: water_quality_anomaly_contributors.(tank_id, detection_id) > water_quality_anomaly_detections.(tank_id, detection_id)

Table batches {
  tank_id varchar [not null, ref: > tanks.tank_id]
  batch_id varchar [not null]
  batch_status varchar [not null, note: 'active | harvested | superseded']
  stocking_date date [not null]
  harvest_date date
  initial_count int [not null]
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id) [pk]
    (tank_id, batch_status)
  }
}

Table sampling_records {
  tank_id varchar [not null]
  batch_id varchar [not null]
  sampling_id varchar [not null]
  sampling_date date [not null]
  sample_size int [not null]
  total_weight_grams decimal(10,2) [not null]
  total_length_cm decimal(10,2) [not null]
  live_count int [not null]
  is_baseline boolean [not null, default: false]
  created_at timestamp [not null]
  Indexes {
    (tank_id, batch_id, sampling_id) [pk]
    (tank_id, batch_id, sampling_date)
  }
}

Table mortality_records {
  tank_id varchar [not null]
  batch_id varchar [not null]
  mortality_id varchar [not null]
  mortality_date date [not null]
  mortality_count int [not null]
  created_at timestamp [not null]
  Indexes { (tank_id, batch_id, mortality_id) [pk] }
}

Table harvest_records {
  tank_id varchar [not null]
  batch_id varchar [not null]
  harvest_id varchar [not null]
  harvest_date date [not null]
  harvest_count int [not null]
  total_weight_kg decimal(10,3) [not null]
  created_at timestamp [not null]
  Indexes { (tank_id, batch_id, harvest_id) [pk] }
}

Ref: sampling_records.(tank_id, batch_id) > batches.(tank_id, batch_id)
Ref: mortality_records.(tank_id, batch_id) > batches.(tank_id, batch_id)
Ref: harvest_records.(tank_id, batch_id) > batches.(tank_id, batch_id)

// Derived values—current population, ABW, ABL, biomass, days in culture,
// sample count, mortality total, and harvest ABW—belong in SQL views/queries.
