digraph DFD { graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.7, ranksep=1.6, splines=polyline, overlap=false, fontname="Arial", fontsize=32, labelloc=t, label="CrayCare Data Flow Diagram Level 1", outputorder=edgesfirst]; node [fontname="Arial", fontsize=16, margin="0.18,0.12", penwidth=1.8]; edge [fontname="Arial", fontsize=12, color="#454545", fontcolor="#171717", arrowsize=0.8];
ADMIN [shape=box, style=filled, fillcolor="#E4F3FF", color="#3494E8", label="System Admin"];
OWNER [shape=box, style=filled, fillcolor="#E4F3FF", color="#3494E8", label="Farm Owner"];
ESP [shape=box, style=filled, fillcolor="#E4F3FF", color="#3494E8", label="IoT Hardware System"];
P1 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="1.0\nReal-Time\nMonitoring"];
P2 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="2.0\nTank Grow-out\nRecord Management"];
P3 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="3.0\nFeeding and\nActuator Control"];
P4 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="4.0\nNotification\nand Alerting"];
P5 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="5.0\nHistorical Analytics,\nAnomaly Detection,\nand Reporting"];
P6 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="6.0\nSettings and\nProfile Management"];
P7 [shape=ellipse, style=filled, fillcolor="#FFFCE6", color="#EBA700", label="7.0\nUser Account Status\nand Hardware Assignment\nManagement"];
D1 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D1|Grow-out Records}"];
D2 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D2|Sensor Data}"];
D3 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D3|Feeding and Actuator\nData}"];
D4 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D4|Notifications}"];
D5 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D5|User Profiles and\nPreferences}"];
D6 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D6|Hardware Assignment Data}"];
D7 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D7|Water Quality Anomaly\nDetection Data}"];
D8 [shape=record, style=filled, fillcolor=white, color="#333333", label="{D8|Sensor Thresholds}"];
{rank=same; ADMIN; OWNER;}
OWNER -> P1 [label="Monitoring request"];
P1 -> OWNER [label="Current dashboard data and\ndevice status"];
ESP -> P1 [label="Temperature, pH, dissolved\noxygen, turbidity,\nwater-level, and feed-level\nreadings"];
P1 -> D2 [label="Latest sensor readings"];
D2 -> P1 [label="Current sensor data"];
OWNER -> P2 [label="Sampling, mortality, harvest,\nand batch records"];
P2 -> OWNER [label="Grow out status, growth\nrecords, sampling history,\nmortality history, and\nharvest history"];
P2 -> D1 [label="Saved grow out records"];
D1 -> P2 [label="Existing grow out records"];
OWNER -> P3 [label="Feed now, schedules, and\nactuator mode requests"];
P3 -> OWNER [label="Feeding status, feeder\nstatus, and actuator status"];
P3 -> ESP [label="Sensor thresholds, feeding\nschedules, feeding commands,\nand actuator modes"];
ESP -> P3 [label="Feeder, aerator, water-pump,\nand actuator status"];
P3 -> D3 [label="Feeding schedules, feeding\nactivity, and actuator logs"];
D3 -> P3 [label="Feeding and actuator records"];
D2 -> P4 [label="Water condition data"];
D3 -> P4 [label="Operational status changes"];
P4 -> OWNER [label="In-app alerts and push\nnotifications"];
P4 -> D4 [label="Saved notification records"];
D4 -> P4 [label="Notification history"];
D1 -> P5 [label="Growth, sampling, mortality,\nand harvest records"];
D2 -> P5 [label="Historical sensor readings"];
D7 -> P5 [label="Stored anomaly detection\nresults"];
OWNER -> P5 [label="Historical data, growth\ntrend, and report requests"];
P5 -> D7 [label="Current and historical\nanomaly detection results"];
P5 -> OWNER [label="Historical sensor data,\ngrowth trends, anomaly\ndetection results, and\nreports"];
OWNER -> P6 [label="Settings and profile updates"];
P6 -> OWNER [label="Updated profile and settings"];
P6 -> D5 [label="Saved profile and preference\ndata"];
D5 -> P6 [label="Profile and preference data"];
P6 -> D8 [label="Saved threshold settings"];
D8 -> P6 [label="Sensor threshold settings"];
P6 -> P3 [label="Updated sensor thresholds"];
ADMIN -> P7 [label="User account status updates"];
ADMIN -> P7 [label="Hardware assignment updates"];
P7 -> ADMIN [label="User list and account status"];
P7 -> ADMIN [label="Hardware assignment status"];
P7 -> D5 [label="Updated user account status"];
D5 -> P7 [label="User profiles and account\nstatus"];
P7 -> D6 [label="Updated hardware assignment\ndata"];
D6 -> P7 [label="Hardware assignment records"];
}
