{
  "users": {
    "_id": "uid",
    "_description": "User profile. Subcollections: notification_settings/preferences and notif_markers. FCM device tokens live in the users/{uid}.fcmTokens array. Only self or admin can read/write.",
    "fields": [
      "full_name (string)",
      "email (string)",
      "role (owner|admin)",
      "status (active|disabled)",
      "tank_id (= uid by default; source of tank ownership)",
      "photo_url / photoUrl (legacy)",
      "created_at (Timestamp)"
    ]
  },
  "users/{uid}/notification_settings/preferences": {
    "_description": "Per-user notification preferences. Created automatically on signup.",
    "fields": ["sound (bool)", "vibration (bool)", "critical (bool)", "warning (bool)", "feeding (bool)", "sampling (bool)", "updated_at (Timestamp)"]
  },
  "hardware_system/currentOwner": {
    "_description": "Single source of truth for hardware assignment.",
    "fields": ["uid (string)", "tank_id (string)", "assigned_by (admin uid)", "assigned_at (Timestamp)"]
  },
  "tanks": {
    "_id": "tank_id (== owner's uid by default)",
    "_description": "One tank per user. Core operational data lives in nested subcollections.",
    "fields": [
      "owner_uid (string)", "current_batch_id (string|null)", "stocking_date (int epoch-ms)",
      "last_sample_date (int epoch-ms)", "sample_count (int)", "initial_population (int)",
      "initial_total_sample_weight (double)", "initial_total_sample_length (double)",
      "is_initialized (bool)", "created_at (Timestamp)"
    ],
    "subcollections": {
      "sensor_readings/latest": {
        "fields": ["temperature", "ph_level", "dissolved_oxygen", "turbidity", "water_level", "recorded_at (Timestamp)"]
      },
      "sensor_readings_history/{YYYY-MM-DD}/entries/{docId}": {
        "fields": ["temp_min, temp_max, temp_avg", "pH_min, pH_max, pH_avg", "DO_min, DO_max, DO_avg", "turbidity_min, turbidity_max, turbidity_avg", "waterLevel_min, waterLevel_max, waterLevel_avg", "recorded_at (Timestamp)"]
      },
      "sensors/{sensorName}": {
        "fields": ["min_value (double)", "max_value (double)", "updated_at (Timestamp)"]
      },
      "actuators/{deviceId}": {
        "fields": ["control_mode (on|off|auto)", "current_state (on|off)", "last_changed"]
      },
      "actuator_logs/{logId}": {
        "fields": ["actuator_type", "action", "type", "logged_at"]
      },
      "feeder/status": {
        "fields": ["status", "dispenseCount", "lastSeen", "last_dispensed_at", "last_dispensed_grams"]
      },
      "feeder_schedules/{scheduleId}": {
        "fields": ["time", "ampm", "timeValue", "grams", "days", "enabled", "isDone", "created_at"]
      },
      "feeder_logs/{logId}": {
        "fields": ["action", "type", "trigger_type", "logged_at"]
      },
      "feeder_commands/{commandId}": {
        "fields": ["command_type", "grams", "issued_by", "issued_at"]
      },
      "machine_learning_assessments/{assessmentId}": {
        "_description": "Hourly water-quality machine-learning assessment. Document current mirrors the latest assessment; timestamp-based document IDs preserve history.",
        "fields": [
          "uid", "tank_id", "level (Low|Moderate|High|Critical|Insufficient)", "confidence (0-100)",
          "driver", "driver_label", "driver_value", "driver_unit", "driver_min", "driver_max",
          "problem", "insight", "action", "ts_epoch (epoch seconds)", "timestamp (ISO-8601 string)"
        ]
      }
    }
  },
  "notifications/{notifId}": {
    "fields": ["uid", "notif_type", "title", "body", "is_read (bool)", "created_at (Timestamp)"]
  },
  "sensorIngestion/current": {
    "fields": ["hardwareId", "temperature", "turbidity", "turbidity_air (bool)", "dissolved_oxygen", "ph_level", "water_level"]
  }
}
