<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/craycare_widget_background"
    android:clickable="true"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="CrayCare logo"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="7dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CrayCare"
            android:textColor="#093F4B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● OFFLINE"
            android:textColor="#DC3545"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/craycare_widget_anomaly_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/craycare_widget_wqad_icon_background"
            android:contentDescription="Water Quality Anomaly Detection"
            android:padding="8dp"
            android:src="@drawable/ic_widget_water_quality" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Water Quality Anomaly Detection"
                android:textColor="#093F4B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_concern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Learning the tank's usual pattern"
                android:textColor="#536A73"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widget_anomaly_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/craycare_widget_status_pill_background"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingBottom="5dp"
            android:text="WAITING"
            android:textColor="#7A8A94"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_temp_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Temperature"
                android:padding="2dp"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="7dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Temperature"
                android:textColor="#274650"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_temp_value"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="--"
                android:textColor="#274650"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_temp_status"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="UNKNOWN"
                android:textColor="#7A8A94"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_ph_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="pH"
                android:padding="2dp"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="7dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="pH"
                android:textColor="#274650"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_ph_value"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="--"
                android:textColor="#274650"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_ph_status"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="UNKNOWN"
                android:textColor="#7A8A94"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_do_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Dissolved Oxygen"
                android:padding="2dp"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="7dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dissolved Oxygen"
                android:textColor="#274650"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_do_value"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="--"
                android:textColor="#274650"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_do_status"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="UNKNOWN"
                android:textColor="#7A8A94"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_turb_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Turbidity"
                android:padding="2dp"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="7dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Turbidity"
                android:textColor="#274650"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_turb_value"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="--"
                android:textColor="#274650"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_turb_status"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="UNKNOWN"
                android:textColor="#7A8A94"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_water_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Water Level"
                android:padding="2dp"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="7dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Water Level"
                android:textColor="#274650"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_water_value"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="--"
                android:textColor="#274650"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_water_status"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="UNKNOWN"
                android:textColor="#7A8A94"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#16093F4B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/craycare_widget_feeding_details_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <ImageView
            android:id="@+id/widget_feed_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Next feeding"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="7dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT FEED"
                android:textColor="#71828A"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No schedule"
                android:textColor="#093F4B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_feed_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="in 00:00"
                android:textColor="#D48806"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:background="#18168B82" />

        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:textColor="#71828A"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_feed_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#093F4B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_feed_amount_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/craycare_widget_status_pill_background"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:text="DEFAULT"
                android:textColor="#D48806"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
