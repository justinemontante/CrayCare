rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Role helpers ────────────────────────────────────────────────
    // An 'admin' role can only be set directly on a users/{uid} document
    // from the Firestore console — there is no app code path that lets a
    // user grant themselves admin.
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function deviceOwnerUid() {
      return exists(/databases/$(database)/documents/hardware_system/currentOwner)
        ? get(/databases/$(database)/documents/hardware_system/currentOwner).data.uid
        : null;
    }

    // The assigned owner of the single shared device.
    function isDeviceOwner() {
      return isSignedIn() && request.auth.uid == deviceOwnerUid();
    }

    // ─── User profiles ───────────────────────────────────────────────
    // Users can read/write their own profile; admins can read/write any
    // profile (needed for the admin screen: disable accounts, change
    // roles, assign the device owner).
    match /users/{uid} {
      allow list: if isAdmin();
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ─── Tank ────────────────────────────────────────────────────────
    // Document ID == owner uid, so the ownership check is on the path.
    match /tanks/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ─── Notification prefs ──────────────────────────────────────────
    match /notifPrefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Tank production data (flat collections) ─────────────────────
    // All documents carry a `tankId` field equal to the owner's UID.
    match /batches/{docId} {
      allow read: if request.auth != null && resource.data.tankId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tankId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.tankId == request.auth.uid;
    }

    match /sampling_records/{docId} {
      allow read: if request.auth != null && resource.data.tankId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tankId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.tankId == request.auth.uid;
    }

    match /mortality_records/{docId} {
      allow read: if request.auth != null && resource.data.tankId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tankId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.tankId == request.auth.uid;
    }

    match /harvest_records/{docId} {
      allow read: if request.auth != null && resource.data.tankId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tankId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.tankId == request.auth.uid;
    }

    // ─── Sensor range config ─────────────────────────────────────────
    // Per-user threshold docs (document id == uid). config/deviceOwner
    // and config/default are special docs only admins can write.
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == document || isAdmin());
    }

    // ─── System configuration ────────────────────────────────────────
    // Admins manage device assignment; any signed-in user can read it
    // (needed for the dashboard to determine device ownership).
    match /system_config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /notifMarkers/{doc} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /migration/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Hardware assignments ─────────────────────────────────────────
    // Admin-managed: hardwareId -> { ownerUid, assignedAt }.
    // Cloud Functions use the server SDK (bypasses rules) to read these.
    // Admins can also read them in-app for the assignment UI.
    match /hardwareAssignments/{hardwareId} {
      allow read, write: if isAdmin();
    }

    // ─── Sensor calibration upload (ESP32 write-only) ───────────────
    // ESP32 writes its current calibration values on boot so the admin
    // screen can confirm what values the board is actually using.
    match /sensorConfig/{hardwareId} {
      allow create, update: if true;   // unauthenticated ESP32 writes
      allow read, delete: if isAdmin();
    }

    // ─── Hardware system (device-owner assignment) ───────────────────
    // Flutter reads this to determine which user owns the shared device.
    // Only admins may write/delete the assignment document.
    match /hardware_system/{doc} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
    }

    // ─── Sensor ingestion (ESP32 write-only) ─────────────────────────
    // ESP32 writes raw data keyed by its hardware ID.
    // Cloud Functions (onSensorIngestionWrite / onSensorIngestionHistoryCreate)
    // resolve hardwareId -> ownerUid and copy into sensorReadings.
    // App clients never need to read ingestion documents.
    match /sensorIngestion/{hardwareId} {
      allow create, update: if true;   // unauthenticated ESP32 writes
      allow read, delete: if isAdmin();
    }

    match /sensorIngestion/{hardwareId}/history/{doc} {
      allow create: if true;           // unauthenticated ESP32 writes
      allow read, delete: if isAdmin();
    }

    // ─── Sensor readings ─────────────────────────────────────────────
    // Written exclusively by Cloud Functions. Each owner has their own
    // document at sensorReadings/{ownerUid} — the document ID IS the
    // owner's UID, so the ownership check is on the path itself.
    match /sensorReadings/{ownerUid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == ownerUid);
      allow create, update: if true;   // server functions write here
    }

    match /sensorReadings/history/{date}/{doc} {
      allow read: if isAdmin() || (isSignedIn() &&
        resource.data.ownerUid == request.auth.uid);
      allow create, update: if true;   // server functions write here
    }

    // ─── Feeder ──────────────────────────────────────────────────────
    // feederSchedules: Flutter (device owner) reads/writes; ESP reads anonymously.
    match /feederSchedules/{doc} {
      allow read: if request.auth != null;                  // ESP polls schedules (anonymous auth)
      allow write: if isDeviceOwner() || isAdmin();
    }

    // feederLogs: ESP creates (anonymous auth); only the device owner can read.
    match /feederLogs/{doc} {
      allow read: if isDeviceOwner() || isAdmin();
      allow create: if request.auth != null;                // ESP + Flutter both create logs
      allow update, delete: if isDeviceOwner() || isAdmin();
    }

    // feederCommands: only the device owner may issue commands; ESP reads and
    // deletes processed commands using anonymous auth.
    match /feederCommands/{doc} {
      allow create: if isDeviceOwner();
      allow read, delete: if request.auth != null;          // ESP polls & deletes (anonymous auth)
      allow update: if false;
    }

    // feederStatus: ESP writes (anonymous auth); only the device owner can read.
    match /feederStatus/{doc} {
      allow read: if isDeviceOwner() || isAdmin();
      allow write: if request.auth != null;                 // ESP writes status (anonymous auth)
    }

    // feederDispatched: Flutter-only; tracks which schedules fired today.
    match /feederDispatched/{doc} {
      allow read, write: if isDeviceOwner() || isAdmin();
    }

    // ─── Device control ──────────────────────────────────────────────
    // deviceModes: Flutter (device owner) writes; ESP reads anonymously.
    match /deviceModes/{doc} {
      allow read: if request.auth != null;                  // ESP reads modes (anonymous auth)
      allow write: if isDeviceOwner() || isAdmin();
    }

    // deviceLogs: Flutter (device owner) creates and reads; no ESP involvement.
    match /deviceLogs/{doc} {
      allow read, create, delete: if isDeviceOwner() || isAdmin();
    }

    // ─── ML / Health ─────────────────────────────────────────────────
    match /mlPredictions/{doc} {
      allow read: if request.auth != null;
      allow create, update: if true;
    }

    match /healthRisk/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if true;
    }
  }
}
