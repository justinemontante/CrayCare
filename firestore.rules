rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return isSignedIn() && myProfile().role == 'admin'; }
    function isTankOwner(tankId) {
      return isSignedIn() && myProfile().tank_id == tankId;
    }
    // One-time self-provisioning for legacy owner profiles that do not yet
    // have a usable tank_id (missing OR empty string). A user can claim only
    // a tank matching their own UID, and only the tank_id key may change.
    function canClaimInitialTank(uid) {
      return isSignedIn() && request.auth.uid == uid &&
        (resource.data.get('tank_id', null) == null || resource.data.tank_id == '') &&
        request.resource.data.tank_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tank_id']);
    }
    function canCreateOwnInitialTank(tankId) {
      return isSignedIn() && request.auth.uid == tankId &&
        request.resource.data.owner_uid == request.auth.uid;
    }
    // Safety guard: owners may only set sensor thresholds inside a safe,
    // physically sensible window per sensor. Absurd values (e.g. temp max
    // 45°C, DO min 0, pH 0-14) would silently disable alerts and endanger
    // the crayfish. Admins are trusted and may write any value.
    function isSafeThreshold(sensorName) {
      let min = request.resource.data.min_value;
      let max = request.resource.data.max_value;
      if (!(min is number) || !(max is number)) return false;
      if (min >= max) return false;
      if (sensorName == 'temperature') {
        return min >= 10.0 && min <= 32.0 && max >= 15.0 && max <= 38.0;
      }
      if (sensorName == 'ph_level') {
        return min >= 4.0 && min <= 7.5 && max >= 6.5 && max <= 10.0;
      }
      if (sensorName == 'dissolved_oxygen') {
        return min >= 1.0 && min <= 8.0 && max >= 3.0 && max <= 15.0;
      }
      if (sensorName == 'turbidity') {
        return min >= 0.0 && min <= 100.0 && max >= 5.0 && max <= 1000.0;
      }
      if (sensorName == 'water_level') {
        return min >= 0.0 && min <= 95.0 && max >= 5.0 && max <= 100.0;
      }
      return false; // unknown sensor -> deny write
    }
    // ESP32 currently authenticates with Firebase anonymous sign-in. This is
    // a practical thesis/demo guard; use a dedicated device identity or server
    // ingestion endpoint for a fully hardened production deployment.
    function isEspSession() { return isSignedIn(); }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // New self-registration can create an owner profile only. Admin-created
      // profiles are handled by the admin branch below.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'owner' &&
        request.resource.data.status == 'active' &&
        request.resource.data.tank_id == request.auth.uid
      );

      // Users may update presentation/token fields only. Role, status, and
      // tank_id are protected because they control authorization.
      allow update: if isAdmin() || canClaimInitialTank(uid) || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'email', 'photo_url', 'photoUrl', 'fcmTokens', 'fcmToken'])
      );
      allow delete: if isAdmin();

      match /notification_settings/{doc} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }
      match /notif_markers/{key} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // Single ESP assignment. Only admins may link/reassign hardware.
    match /hardware_system/{doc} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
    }

    match /tanks/{tankId} {
      allow read: if isTankOwner(tankId) || isAdmin();
      allow create: if isTankOwner(tankId) || isAdmin() || canCreateOwnInitialTank(tankId);
      allow update: if isTankOwner(tankId) || isAdmin();
      allow delete: if isAdmin();

      match /sensor_readings/{doc} {
        allow read: if isTankOwner(tankId) || isAdmin();
        // Canonical readings are normally written by Admin SDK Cloud Functions.
        // Authenticated ESP is retained for the thesis/demo fallback.
        allow create, update: if isEspSession();
      }
      match /sensor_readings_history/{dateStr}/entries/{entryId} {
        allow read: if isTankOwner(tankId) || isAdmin();
        allow create, update: if isEspSession();
      }

      // The ESP must read the current assigned tank's thresholds. Thresholds
      // contain no private personal data; writes remain owner/admin only.
      // Owners are restricted to SAFE values (see isSafeThreshold) so they
      // cannot disable alerts by setting absurd thresholds.
      match /sensors/{sensorName} {
        allow read: if isTankOwner(tankId) || isAdmin() || isEspSession();
        allow create: if isAdmin() || (isTankOwner(tankId) && isSafeThreshold(sensorName));
        allow update: if isAdmin() || (isTankOwner(tankId) && isSafeThreshold(sensorName));
        allow delete: if isAdmin();
      }
      match /actuators/{actuatorId} {
        // Owners/admins control the mode. The anonymous ESP32 reads it and
        // reports back the ACTUAL relay state (current_state + last_changed).
        allow read: if isTankOwner(tankId) || isAdmin() || isEspSession();
        allow write: if isTankOwner(tankId) || isAdmin();
        allow update: if isEspSession() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['current_state', 'last_changed']);
      }
      match /actuator_logs/{logId} {
        allow read: if isTankOwner(tankId) || isAdmin();
        // ESP32 creates log entries when it physically changes a relay.
        allow create: if isTankOwner(tankId) || isAdmin() || isEspSession();
        allow update, delete: if isAdmin();
      }
      match /feeder/{doc} {
        allow read: if isTankOwner(tankId) || isAdmin();
        allow write: if isEspSession() || isTankOwner(tankId) || isAdmin();
      }
      match /feeder_schedules/{scheduleId} {
        allow read: if isTankOwner(tankId) || isAdmin() || isEspSession();
        allow write: if isTankOwner(tankId) || isAdmin();
      }
      match /pending_commands/{commandId} {
        allow create: if isTankOwner(tankId) || isAdmin();
        allow read, delete: if isEspSession() || isTankOwner(tankId) || isAdmin();
        allow update: if false;
      }
      match /feeder_logs/{logId} {
        allow read: if isTankOwner(tankId) || isAdmin();
        allow create: if isEspSession() || isTankOwner(tankId) || isAdmin();
        allow update, delete: if isTankOwner(tankId) || isAdmin();
      }
      match /feeder_dispatched/{dateKey} {
        allow read, write: if isTankOwner(tankId) || isAdmin();
      }

      // ML output for this tank.
      match /health_risk/{docId} {
        allow read: if isTankOwner(tankId) || isAdmin();
        // Written by the Admin SDK ML function; never directly by an app/ESP.
        allow create, update, delete: if false;
      }

      // Production records now live under their owning tank and batch.
      match /batches/{batchId} {
        allow read, write: if isTankOwner(tankId) || isAdmin();

        match /sampling_records/{docId} {
          allow read, write: if isTankOwner(tankId) || isAdmin();
        }
        match /mortality_records/{docId} {
          allow read, write: if isTankOwner(tankId) || isAdmin();
        }
        match /harvest_records/{docId} {
          allow read, write: if isTankOwner(tankId) || isAdmin();
        }
      }
    }
    match /notifications/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ESP staging paths. Cloud Functions route these into the assigned tank.
    match /sensorIngestion/current {
      allow create, update: if isEspSession();
      allow read, delete: if isAdmin();
    }
    match /sensorIngestion/current/history/{doc} {
      allow create: if isEspSession();
      allow read, delete: if isAdmin();
    }

    match /mlPredictions/{doc} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
    }
  }
}
