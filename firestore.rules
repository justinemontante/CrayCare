rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() &&
        myProfile().role == 'admin' &&
        myProfile().get('status', 'active') == 'active';
    }
    function isTankOwner(tankId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/tanks/$(tankId)) &&
        get(/databases/$(database)/documents/tanks/$(tankId)).data.owner_uid == request.auth.uid &&
        myProfile().get('status', 'active') == 'active';
    }
    function canBackfillLegacyProfile(uid) {
      return isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'email', 'role', 'status']) &&
        request.resource.data.role == resource.data.get('role', 'owner') &&
        request.resource.data.role == 'owner' &&
        request.resource.data.status == resource.data.get('status', 'active') &&
        request.resource.data.status == 'active';
    }
    function canCreateOwnInitialTank(tankId) {
      return isSignedIn() && request.auth.uid == tankId &&
        myProfile().role == 'owner' &&
        myProfile().get('status', 'active') == 'active' &&
        request.resource.data.owner_uid == request.auth.uid;
    }
    function canAccessOwnCanonicalTank(tankId) {
      return isSignedIn() && request.auth.uid == tankId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'owner' &&
        myProfile().get('status', 'active') == 'active';
    }
    function isSafeThreshold(sensorName) {
      let min = request.resource.data.min_value;
      let max = request.resource.data.max_value;
      let validNumbers = (min is number) && (max is number) && (min < max);
      let tempOk = sensorName == 'temperature' && min >= 10.0 && min <= 32.0 && max >= 15.0 && max <= 38.0;
      let phOk = sensorName == 'ph_level' && min >= 4.0 && min <= 7.5 && max >= 6.5 && max <= 10.0;
      let doOk = sensorName == 'dissolved_oxygen' && min >= 1.0 && min <= 8.0 && max >= 3.0 && max <= 15.0;
      let turbOk = sensorName == 'turbidity' && min >= 0.0 && min <= 100.0 && max >= 5.0 && max <= 1000.0;
      let waterOk = sensorName == 'water_level' && min >= 0.0 && min <= 95.0 && max >= 5.0 && max <= 100.0;
      let feedCritical = request.resource.data.get('critical_value', -1);
      let feedCapacity = request.resource.data.get('hopper_capacity_grams', 0);
      let feedOk = sensorName == 'feed_level' &&
        min >= 1.0 && min <= 50.0 && max == 100.0 &&
        feedCritical is number && feedCritical >= 0.0 && feedCritical < min &&
        feedCapacity is number && feedCapacity >= 100.0 && feedCapacity <= 50000.0;
      return validNumbers && (tempOk || phOk || doOk || turbOk || waterOk || feedOk);
    }
    function isEspSession() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        request.auth.token.get('email', '') == 'esp32@craycare.com';
    }
    function isAssignedEsp(tankId) {
      return isEspSession() &&
        get(/databases/$(database)/documents/hardware_system/currentOwner).data.tank_id == tankId;
    }
    function ownerChangesOnlyControlMode(tankId) {
      return isTankOwner(tankId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['control_mode']) &&
        request.resource.data.control_mode in ['on', 'off', 'auto'];
    }
    function isValidHardwareAssignment() {
      let uid = request.resource.data.get('uid', null);
      let tankId = request.resource.data.get('tank_id', null);
      return (uid == null && tankId == null) || (
        uid is string && uid.size() > 0 &&
        tankId is string && tankId.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        exists(/databases/$(database)/documents/tanks/$(tankId)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'owner' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'active') == 'active' &&
        get(/databases/$(database)/documents/tanks/$(tankId)).data.owner_uid == uid
      );
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if (isAdmin() && request.resource.data.role == 'owner') || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'owner' &&
        request.resource.data.status == 'active'
      );
      allow update: if (isAdmin() &&
          request.resource.data.role == resource.data.role) ||
        canBackfillLegacyProfile(uid) || (
          isSignedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['full_name', 'email', 'photo_url', 'photoUrl', 'fcmTokens', 'fcmToken', 'tank_id']) &&
          // NOTE: `tank_id` is legacy. This clause is delete-only on purpose:
          // a client may remove the field but never set it (ownership lives
          // in tanks/{tankId}.owner_uid).
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tank_id']) ||
            !request.resource.data.keys().hasAny(['tank_id']))
        );
      allow delete: if isAdmin();

      match /notification_settings/{doc} {
        allow read, write: if isSignedIn() &&
          request.auth.uid == uid &&
          get(/databases/$(database)/documents/users/$(uid)).data.role == 'owner';
      }
      match /notif_markers/{key} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /hardware_system/{doc} {
      // The assigned owner may read the assignment (no cross-owner leak:
      // only the uid recorded on the doc itself can read it). This removes
      // the app's tankId==uid assumption for future multi-tank use.
      allow read: if isAdmin() || isEspSession() || (isSignedIn() &&
        get(/databases/$(database)/documents/hardware_system/currentOwner)
          .data.get('uid', '') == request.auth.uid);
      allow create, update: if isAdmin() &&
        (doc != 'currentOwner' || isValidHardwareAssignment());
      allow delete: if isAdmin();
    }

    match /tanks/{tankId} {
      // An active owner must be able to check whether tanks/{uid} exists
      // before first-time provisioning. Keep collection listing admin-only.
      allow get: if isTankOwner(tankId) || isAdmin() || canAccessOwnCanonicalTank(tankId);
      allow list: if isAdmin();
      allow create: if isTankOwner(tankId) || isAdmin() || canCreateOwnInitialTank(tankId);
      allow update: if isAdmin() || (isTankOwner(tankId) &&
        request.resource.data.owner_uid == resource.data.owner_uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'owner_uid', 'is_initialized', 'current_batch_id'
        ]));
      allow delete: if isAdmin();

      match /sensor_readings/{doc} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        allow create, update, delete: if false;
      }
      match /sensor_readings_history/{dateStr} {
        // Parent day documents are server-maintained daily summaries. Owners
        // may read them for long-range Analytics, but clients can never write.
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        allow create, update, delete: if false;

        match /entries/{entryId} {
          allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
          allow create, update, delete: if false;
        }
      }
      match /sensors/{sensorName} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId) || isAssignedEsp(tankId);
        allow create: if isAdmin() || (isTankOwner(tankId) && isSafeThreshold(sensorName));
        allow update: if isAdmin() || (isTankOwner(tankId) && isSafeThreshold(sensorName));
        allow delete: if false;
      }
      match /actuators/{actuatorId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId) || isAssignedEsp(tankId);
        allow create: if isTankOwner(tankId) || isAdmin();
        allow update: if ownerChangesOnlyControlMode(tankId) ||
          (isAssignedEsp(tankId) && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['current_state', 'last_changed']));
        allow delete: if false;
      }
      match /actuator_logs/{logId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        // Owner audit entries must NOT impersonate device events: any
        // action containing "(AUTO)" is ESP-only to keep push + audit clean.
        allow create: if isAssignedEsp(tankId) || (isTankOwner(tankId) &&
          !request.resource.data.get('action', '').matches('.*\\(AUTO\\).*'));
        allow update, delete: if false;
      }
      match /feeder/{doc} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId) || isAssignedEsp(tankId);
        allow create: if doc != 'schedule_guard' && (isTankOwner(tankId) || isAdmin() || isAssignedEsp(tankId));
        allow update: if doc != 'schedule_guard' && isAssignedEsp(tankId);
        allow delete: if false;
      }
      match /feeder_schedules/{scheduleId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId) || isAssignedEsp(tankId);
        // The callable serializes owner changes and rejects overlapping days
        // and times. Direct/offline writes would bypass that shared lock.
        allow create, delete: if false;
        allow update: if (isAssignedEsp(tankId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDone']) &&
            request.resource.data.isDone == true);
      }
      match /feeder_commands/{commandId} {
        // Validate manual feed requests so a stale/offline write cannot
        // become a live motor command: type fixed, grams bounded, expiry
        // required and near-future, issuer must match the owner.
        allow create: if isTankOwner(tankId) &&
          request.resource.data.keys().hasOnly([
            'command_type', 'grams', 'issued_by', 'issued_at',
            'expires_at', 'near_schedule_confirmed'
          ]) &&
          request.resource.data.command_type == 'feed_now' &&
          request.resource.data.grams is number &&
          request.resource.data.grams >= 1.0 &&
          request.resource.data.grams <= 5000.0 &&
          request.resource.data.issued_by == request.auth.uid &&
          request.resource.data.issued_at is timestamp &&
          request.resource.data.expires_at is timestamp &&
          request.resource.data.expires_at > request.resource.data.issued_at &&
          request.resource.data.expires_at <= request.resource.data.issued_at + duration.value(5, 'm') &&
          request.resource.data.near_schedule_confirmed is bool;
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId) || isAssignedEsp(tankId);
        allow delete: if isTankOwner(tankId) || isAssignedEsp(tankId);
        allow update: if false;
      }
      match /feeder_logs/{logId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        allow create: if isAssignedEsp(tankId) || (isTankOwner(tankId) &&
          request.resource.data.keys().hasOnly([
            'action', 'type', 'logged_at', 'schedule_key', 'schedule_time'
          ]) &&
          request.resource.data.type in ['auto', 'manual', 'missed', 'error', 'pending_confirmation'] &&
          request.resource.data.action is string &&
          request.resource.data.logged_at is int);
        // Feeding history is an append-only audit trail. Confirmed device
        // outcomes and owner-created schedule audit entries cannot be changed
        // or erased after the first successful write.
        allow update, delete: if false;
      }

      match /water_quality_anomaly_detections/{docId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        allow create, update, delete: if false;
      }

      match /batches/{batchId} {
        allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
        allow write: if isTankOwner(tankId);
        match /sampling_records/{docId} {
          allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
          allow write: if isTankOwner(tankId);
        }
        match /mortality_records/{docId} {
          allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
          allow write: if isTankOwner(tankId);
        }
        match /harvest_records/{docId} {
          allow read: if isTankOwner(tankId) || canAccessOwnCanonicalTank(tankId);
          allow write: if isTankOwner(tankId);
        }
      }
    }

    match /notifications/{docId} {
      // Notifications are server-created (Admin SDK bypasses rules).
      // Client create is disabled so a compromised client cannot squat a
      // deterministic inbox ID and suppress a real push (deliver-once
      // checks existence before sending).
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /sensorIngestion/current {
      allow create, update: if isEspSession();
      allow read, delete: if isAdmin();
    }
    match /sensorIngestion/current/history/{doc} {
      allow create: if isEspSession();
      allow read, delete: if isAdmin();
    }
  }
}
