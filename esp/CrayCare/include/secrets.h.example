// ── main.cpp (default env: esp32dev_main, anonymous auth) ──────────
// Found in: Firebase Console > Project settings > General > Your apps
#define FIREBASE_API_KEY        "PASTE_YOUR_WEB_OR_ANDROID_API_KEY"
#define FIREBASE_DATABASE_URL   "https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app"
