#define SECRETS_FIREBASE_API_KEY        "PASTE_YOUR_API_KEY"
#define SECRETS_FIREBASE_USER_EMAIL     "esp32@yourdomain.com"
#define SECRETS_FIREBASE_USER_PASSWORD  "CHANGE_ME_STRONG_PASSWORD"
#define SECRETS_FIREBASE_DATABASE_URL   "https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app"
