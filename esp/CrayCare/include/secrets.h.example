#pragma once

// ============================================================
//  CrayCare ESP32 - Credentials Template
// ============================================================
//  HOW TO USE (pagka-clone ng repo):
//  1. Copy this file:  cp include/secrets.h.example include/secrets.h
//  2. Fill in the REAL values (from the Firebase console / team lead)
//  3. DO NOT COMMIT secrets.h - it is already in .gitignore
//     (verify:  git check-ignore include/secrets.h  -> prints the path)
// ============================================================

// ── main.cpp (default env: esp32dev_main, email/password auth) ─────
// From Firebase Console -> Project Settings -> General -> Web API Key
#define FIREBASE_API_KEY        "PASTE-WEB-API-KEY-HERE"
// From Firebase Console -> Realtime Database -> database URL
#define FIREBASE_DATABASE_URL   "https://PROJECT-ID-default-rtdb.asia-southeast1.firebasedatabase.app"
// From Firebase Console -> Project Settings -> Project ID
#define FIREBASE_PROJECT_ID     "PROJECT-ID"

// Dedicated Firebase Authentication Email/Password service account.
// Create this user in Firebase Authentication; never commit its password.
#define SECRETS_FIREBASE_USER_EMAIL     "esp32@craycare.com"
#define SECRETS_FIREBASE_USER_PASSWORD  "PASTE-ROTATED-ESP-ACCOUNT-PASSWORD"

// ── common.cpp (backup envs using email+password auth) ─────────────
// These aliases retain the remaining Firebase values used by backup builds.
#define SECRETS_FIREBASE_API_KEY        "PASTE-WEB-API-KEY-HERE"
#define SECRETS_FIREBASE_DATABASE_URL   "https://PROJECT-ID-default-rtdb.asia-southeast1.firebasedatabase.app"
#define SECRETS_FIREBASE_PROJECT_ID     "PROJECT-ID"

// Optional: Hardware ID (defaults to MAC if left empty)
#define HARDWARE_ID       ""
